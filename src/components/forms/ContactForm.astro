---
import { site } from '../../data/site';
import Arrow from '../common/Arrow.astro';
const id = import.meta.env.PUBLIC_FORMSPREE_ID?.trim();
const enabled = Boolean(id) && !site.demo;
---

<div class="contact-form">
  <h2>{site.contact.formTitle}</h2>
  <p>{site.contact.formIntro}</p>
  {!enabled && (
    <p class="demo-note">Form contoh — pesan belum dapat dikirim.</p>
  )}
  <form
    id="contact-form"
    method="POST"
    action={enabled ? `https://formspree.io/f/${id}` : undefined}
  >
    <label>
      Nama
      <input
        class="form-field"
        type="text"
        name="name"
        required
        autocomplete="name"
        placeholder="Nama lengkap Anda"
      />
    </label>
    <label>
      Email
      <input
        class="form-field"
        type="email"
        name="email"
        required
        autocomplete="email"
        placeholder="nama@perusahaan.com"
      />
    </label>
    <label>
      Pesan
      <textarea
        class="form-field"
        name="message"
        rows="4"
        required
        minlength="10"
        placeholder="Apa yang ingin Anda bicarakan?"
      ></textarea>
    </label>
    <div hidden aria-hidden="true">
      <label>
        Jangan isi kolom ini
        <input name="_gotcha" tabindex="-1" autocomplete="off" />
      </label>
    </div>
    <button type="submit" class="button button--primary" disabled={!enabled}>
      <span>Kirim pesan</span>
      <Arrow />
    </button>
    <p class="form-status">
      {enabled
        ? 'Pesan dikirim melalui Formspree. Setelah terkirim, Anda akan diarahkan ke halaman konfirmasi.'
        : 'Anda dapat mencoba mengisi kolom di atas. Pengiriman dinonaktifkan pada contoh ini.'}
    </p>
  </form>
</div>
