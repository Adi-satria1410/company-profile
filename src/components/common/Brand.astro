---
import { site } from '../../data/site';
---

<a href="/" class="brand" aria-label={`${site.name} — ${site.labels.home}`}>
  {site.logo ? (
    <img src={site.logo} alt="" width="40" height="40" />
  ) : (
    <svg
      viewBox="0 0 40 40"
      width="38"
      height="38"
      fill="none"
      aria-hidden="true"
    >
      <path
        d="M6 32V8h7l14 24h7V8M6 8l28 24M13 8v24M27 8v24"
        stroke="currentColor"
        stroke-width="2"
      />
    </svg>
  )}
  <span class="brand-type">
    {site.shortName}
    <small>{site.descriptor}</small>
  </span>
</a>
