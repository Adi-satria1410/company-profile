---
interface Props { href: string; variant?: 'primary' | 'accent' | 'outline'; class?: string }
const { href, variant = 'primary', class: cls = '' } = Astro.props;
const styles = {
  primary: 'bg-primary text-white hover:bg-primary-dark',
  accent: 'bg-accent text-ink-900 hover:brightness-95',
  outline: 'border border-ink-900/20 text-ink-900 hover:bg-ink-50',
};
---
<a href={href} class:list={['inline-flex min-h-11 items-center justify-center rounded-full px-6 text-sm font-semibold transition-colors', styles[variant], cls]}><slot /></a>
