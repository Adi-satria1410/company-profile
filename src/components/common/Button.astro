---
import Arrow from './Arrow.astro';
interface Props {
  href: string;
  variant?: 'primary' | 'accent' | 'outline';
  class?: string;
}
const { href, variant = 'primary', class: cls } = Astro.props;
---

<a href={href} class:list={['button', `button--${variant}`, cls]}>
  <span>
    <slot />
  </span>
  <Arrow />
</a>
