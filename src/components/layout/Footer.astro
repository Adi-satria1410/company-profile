---
import { site } from '../../data/site';
import { getSiteContent } from '../../data/content';
import Arrow from '../common/Arrow.astro';
const { nav } = await getSiteContent();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <p class="footer-note preserve-lines">{site.footer.note}</p>
      <div>
        <p class="eyebrow">{site.footer.navigation}</p>
        <nav aria-label="Navigasi footer">
          <a href="/">{site.labels.home}</a>
          {nav.map((n) => (
            <a href={n.href}>{n.label}</a>
          ))}
          <a href="/kontak">{site.labels.contact}</a>
        </nav>
      </div>
      <div class="footer-contact">
        <p class="eyebrow">{site.footer.contact}</p>
        {site.address && <p>{site.address}</p>}
        {site.email && (
          <a href={`mailto:${site.email}`}>
            {site.email}
            <Arrow diagonal />
          </a>
        )}
        {site.whatsapp && (
          <a href={`https://wa.me/${site.whatsapp}`}>
            WhatsApp
            <Arrow diagonal />
          </a>
        )}
      </div>
    </div>
    <div
      class="footer-wordmark"
      style={`--word-length: ${Math.max(site.shortName.length * 0.58, 6)}`}
    >
      {site.shortName}
      <span class="brand-dot">.</span>
    </div>
    <div class="footer-bottom">
      <span>
        © {new Date().getFullYear()} {site.name}
      </span>
      {site.demo ? (
        <a href="/tentang-proyek">
          Template demo · Konten & foto ilustratif{' '}
          <span aria-hidden="true">↗</span>
        </a>
      ) : (
        <span>Hak cipta dilindungi.</span>
      )}
      <a href="#top">Kembali ke atas ↑</a>
    </div>
  </div>
</footer>
