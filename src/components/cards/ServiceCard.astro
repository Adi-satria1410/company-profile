---
interface Props { title: string; summary: string; href: string }
const { title, summary, href } = Astro.props;
---
<a href={href} class="block rounded-card border border-ink-200 p-6 hover:border-primary">
  <h3 class="text-xl font-bold">{title}</h3>
  <p class="mt-2 text-ink-500">{summary}</p>
  <span class="mt-4 inline-block text-sm font-semibold text-primary">Lihat detail</span>
</a>
