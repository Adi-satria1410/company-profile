---
import Arrow from '../common/Arrow.astro';
import { site } from '../../data/site';
interface Props {
  title: string;
  summary: string;
  href: string;
  index?: number;
}
const { title, summary, href, index = 1 } = Astro.props;
---

<a href={href} class="service-card">
  <span class="eyebrow">{String(index).padStart(2, '0')}</span>
  <h2>{title}</h2>
  <p>{summary}</p>
  <span class="text-link">
    {site.labels.detail}
    <Arrow diagonal />
  </span>
</a>
