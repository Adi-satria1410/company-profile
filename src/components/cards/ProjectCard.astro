---
import Arrow from '../common/Arrow.astro';
import { imageSrcSet } from '../../data/images';
interface Props {
  title: string;
  category?: string;
  image?: string;
  alt?: string;
  summary: string;
  href: string;
}
const { title, category, image, alt, summary, href } = Astro.props;
---

<a href={href} class="project-card">
  {image && (
    <div class="project-image">
      <img
        src={image}
        srcset={imageSrcSet(image)}
        sizes="(max-width: 767px) 100vw, 45vw"
        alt={alt ?? ''}
        width="1000"
        height="750"
        loading="lazy"
        decoding="async"
      />
      <span class="circle-arrow">
        <Arrow diagonal />
      </span>
    </div>
  )}
  <div class="project-info">
    {category && <p class="eyebrow">{category}</p>}
    <h3>{title}</h3>
    <p class="project-summary">{summary}</p>
  </div>
</a>
