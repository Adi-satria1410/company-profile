---
interface Props { title: string; client: string; year: number; category: string; summary: string; href: string }
const { title, client, year, category, summary, href } = Astro.props;
---
<a href={href} class="block overflow-hidden rounded-card border border-ink-200 hover:border-primary">
  <div class="flex h-36 items-end bg-primary p-4" aria-hidden="true">
    <span class="rounded-full bg-accent px-3 py-1 text-xs font-semibold text-ink-900">{category}</span>
  </div>
  <div class="p-6">
    <h3 class="text-lg font-bold">{title}</h3>
    <p class="text-sm text-ink-500">{client}, {year}</p>
    <p class="mt-2">{summary}</p>
  </div>
</a>
