---
import Container from '../common/Container.astro';
import Button from '../common/Button.astro';
import { site } from '../../data/site';
---
<section class="bg-ink-50 py-20 sm:py-28">
  <Container class="grid items-center gap-12 lg:grid-cols-2">
    <div>
      <h1 class="text-4xl font-extrabold tracking-tight sm:text-5xl lg:text-6xl">{site.tagline}</h1>
      <p class="mt-6 max-w-xl text-lg">Kami adalah perusahaan yang berdedikasi memberikan solusi terbaik untuk mendukung pertumbuhan bisnis Anda secara berkelanjutan.</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <Button href="/kontak" variant="accent">Hubungi kami</Button>
        <Button href="/layanan" variant="outline">Lihat layanan</Button>
      </div>
    </div>
    <div class="relative hidden h-80 lg:block" aria-hidden="true">
      <div class="absolute inset-0 rounded-card bg-primary"></div>
      <div class="absolute -bottom-4 -left-4 h-28 w-28 rounded-full bg-accent"></div>
      <div class="absolute right-8 top-8 h-40 w-40 rounded-card border-4 border-white/30"></div>
    </div>
  </Container>
</section>
