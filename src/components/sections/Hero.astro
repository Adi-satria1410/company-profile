---
import { site } from '../../data/site';
import { imageSrcSet } from '../../data/images';
import Button from '../common/Button.astro';
import Arrow from '../common/Arrow.astro';
---

<section class="hero container" aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="eyebrow">
      <span class="status-dot"></span>
      {site.hero.eyebrow}
    </p>
    <h1 id="hero-title">
      {site.hero.title}
      <br />
      <span>{site.hero.emphasis}</span>
    </h1>
    <p class="hero-description">{site.description}</p>
    <div class="hero-actions">
      <Button href="/kontak">{site.labels.contactCta}</Button>
      <a class="text-link" href="/tentang">
        {site.labels.aboutCta}
        <Arrow diagonal />
      </a>
    </div>
    <div class="hero-caption">
      <span class="tiny-mark" aria-hidden="true">
        ✳
      </span>
      <span>{site.hero.note}</span>
    </div>
  </div>
  <div class="hero-visual">
    <img
      src={site.hero.image}
      srcset={imageSrcSet(site.hero.image)}
      sizes="(max-width: 767px) 100vw, 50vw"
      alt={site.hero.alt}
      width="1600"
      height="1067"
      fetchpriority="high"
    />
    <div class="photo-label">
      <span>{site.name}</span>
      <span aria-hidden="true">01 / 03</span>
    </div>
    <a
      href="#sekilas"
      class="hero-stamp"
      aria-label="Jelajahi profil perusahaan"
    >
      <span>
        KENALI
        <br />
        LEBIH DEKAT
      </span>
      <Arrow diagonal />
    </a>
  </div>
</section>
