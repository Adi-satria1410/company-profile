---
import { site } from '../../data/site';
---

{site.sections.stats && site.stats.length > 0 && (
  <section class="container stats-grid" aria-label="Perusahaan dalam angka">
    {site.stats.map((s) => (
      <div>
        <strong>{s.value}</strong>
        <p>{s.label}</p>
      </div>
    ))}
  </section>
)}
