---
import Container from '../common/Container.astro';
import Button from '../common/Button.astro';
---
<section class="py-4">
  <Container>
    <div class="flex flex-col items-start justify-between gap-6 rounded-card bg-primary p-8 text-white sm:flex-row sm:items-center">
      <div>
        <h2 class="text-2xl font-bold !text-white">Siap untuk bekerja sama?</h2>
        <p class="mt-1 text-white/80">Konsultasikan kebutuhan bisnis Anda, kami siap membantu.</p>
      </div>
      <Button href="/kontak" variant="accent">Hubungi kami</Button>
    </div>
  </Container>
</section>
