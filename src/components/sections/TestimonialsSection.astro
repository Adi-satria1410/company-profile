---
import { getCollection } from 'astro:content';
import { site } from '../../data/site';
const items = site.sections.testimonials
  ? (await getCollection('testimonials'))
      .sort((a, b) => a.data.order - b.data.order)
      .slice(0, 3)
  : [];
---

{items.length > 0 && (
  <section class="testimonials-section">
    <div class="container">
      <p class="eyebrow">{site.labels.testimonials}</p>
      <div class="testimonials-grid">
        {items.map((t) => (
          <figure>
            <blockquote>“{t.data.quote}”</blockquote>
            <figcaption>
              {t.data.name}
              <span>
                {t.data.role} · {t.data.company}
              </span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
)}
