---
import { site } from '../../data/site';
import { getSiteContent } from '../../data/content';
import ProjectCard from '../cards/ProjectCard.astro';
import Arrow from '../common/Arrow.astro';
const { projects } = await getSiteContent();
const featured = projects.filter((p) => p.data.featured);
const items = (featured.length ? featured : projects).slice(0, 3);
---

{items.length > 0 && (
  <section class="section container">
    <div class="section-top">
      <div>
        <p class="eyebrow">03 / {site.labels.projects}</p>
        <h2>{site.activities.title}</h2>
      </div>
      <a href="/portofolio" class="text-link">
        {site.labels.allProjects}
        <Arrow diagonal />
      </a>
    </div>
    <div class="projects-grid">
      {items.map((p) => (
        <ProjectCard {...p.data} href={`/portofolio/${p.id}`} />
      ))}
    </div>
  </section>
)}
