---
import { getCollection } from 'astro:content';
import Container from '../common/Container.astro';
import SectionHeading from '../common/SectionHeading.astro';
import ProjectCard from '../cards/ProjectCard.astro';
const projects = (await getCollection('projects', (p) => p.data.featured)).sort((a, b) => a.data.order - b.data.order).slice(0, 3);
---
<section class="py-20">
  <Container>
    <SectionHeading title="Proyek unggulan" description="Beberapa proyek yang telah kami kerjakan bersama klien." />
    <div class="grid gap-6 md:grid-cols-3">
      {projects.map((p) => <ProjectCard {...p.data} href={`/portofolio/${p.id}`} />)}
    </div>
  </Container>
</section>
