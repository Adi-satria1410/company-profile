---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/common/Button.astro';
import { site } from '../data/site';
---

<BaseLayout title="Halaman tidak ditemukan" noindex>
  <section class="container section">
    <p class="eyebrow">404 / HALAMAN TIDAK DITEMUKAN</p>
    <div class="page-heading">
      <h1>
        Sepertinya Anda
        <br />
        berbelok terlalu jauh.
      </h1>
      <p>Halaman yang dicari tidak tersedia. Mari kembali ke awal.</p>
    </div>
    <Button href="/">{site.labels.home}</Button>
  </section>
</BaseLayout>
