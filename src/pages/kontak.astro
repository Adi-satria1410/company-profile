---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/common/Container.astro';
import Button from '../components/common/Button.astro';
import ContactForm from '../components/forms/ContactForm.astro';
import { site } from '../data/site';
---
<BaseLayout title="Kontak" description="Hubungi Nusantara Group lewat form, email, atau WhatsApp.">
  <Container class="grid gap-12 py-16 lg:grid-cols-2">
    <div>
      <h1 class="text-4xl font-extrabold tracking-tight">Hubungi kami</h1>
      <p class="mt-4 text-lg">Kami siap mendengarkan kebutuhan Anda. Silakan hubungi kami kapan saja.</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <Button href={`mailto:${site.email}`} variant="outline">Kirim email</Button>
        <Button href={`https://wa.me/${site.whatsapp}`} variant="accent">Chat WhatsApp</Button>
      </div>
    </div>
    <ContactForm />
  </Container>
</BaseLayout>
