---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/forms/ContactForm.astro';
import Arrow from '../components/common/Arrow.astro';
import { site } from '../data/site';
---

<BaseLayout title={site.labels.contact} description={site.contact.description}>
  <div class="container contact-page">
    <div>
      <div class="page-heading">
        <p class="eyebrow">{site.contact.eyebrow}</p>
        <h1>{site.contact.title}</h1>
        <p>{site.contact.description}</p>
      </div>
      <div class="contact-details">
        {site.email && (
          <>
            <p class="eyebrow">EMAIL</p>
            <a href={`mailto:${site.email}`}>
              {site.email}
              <Arrow diagonal />
            </a>
          </>
        )}
        {site.whatsapp && (
          <>
            <p class="eyebrow">WHATSAPP</p>
            <a href={`https://wa.me/${site.whatsapp}`}>
              WhatsApp
              <Arrow diagonal />
            </a>
          </>
        )}
        {site.address && (
          <>
            <p class="eyebrow">LOKASI</p>
            <p>{site.address}</p>
          </>
        )}
      </div>
    </div>
    <ContactForm />
  </div>
</BaseLayout>
