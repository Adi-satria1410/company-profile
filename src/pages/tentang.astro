---
import { getCollection } from 'astro:content';
import { site } from '../data/site';
import { imageSrcSet } from '../data/images';
import BaseLayout from '../layouts/BaseLayout.astro';
import CTABanner from '../components/sections/CTABanner.astro';
const team = site.sections.team
  ? (await getCollection('team')).sort((a, b) => a.data.order - b.data.order)
  : [];
---

<BaseLayout title={site.labels.about} description={site.about.intro}>
  <div class="container">
    <div class="page-heading">
      <p class="eyebrow">
        {site.labels.about} / {site.name}
      </p>
      <h1 class="preserve-lines">{site.about.title}</h1>
      <p>{site.about.intro}</p>
    </div>
    <img
      class="page-photo"
      src={site.about.image}
      srcset={imageSrcSet(site.about.image)}
      sizes="100vw"
      alt={site.about.alt}
      width="1400"
      height="933"
      fetchpriority="high"
    />
    <section class="section two-column">
      <div>
        <p class="eyebrow">{site.about.eyebrow}</p>
        <h2>{site.name}</h2>
      </div>
      <div>
        <p>{site.about.description}</p>
        <p>{site.description}</p>
      </div>
    </section>
    <section class="two-column section" style="padding-top:0">
      <div>
        <p class="eyebrow">01 / VISI</p>
        <h2>Tujuan kami.</h2>
        <p>{site.about.vision}</p>
      </div>
      <div>
        <p class="eyebrow">02 / MISI</p>
        <h2>Langkah kami.</h2>
        <p>{site.about.mission}</p>
      </div>
    </section>
  </div>
  <section class="tinted section">
    <div class="container">
      <p class="eyebrow">{site.commitment.eyebrow}</p>
      <div class="section-heading">
        <h2 class="preserve-lines">{site.commitment.title}</h2>
      </div>
      <div class="values-grid">
        {site.values.map((v) => (
          <div>
            <h3>{v.title}</h3>
            <p>{v.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  {team.length > 0 && (
    <section class="section container">
      <div class="section-heading">
        <h2>{site.labels.team}</h2>
      </div>
      <div class="team-grid">
        {team.map((m) => (
          <div>
            <h3>{m.data.name}</h3>
            <p>{m.data.role}</p>
          </div>
        ))}
      </div>
    </section>
  )}
  <CTABanner />
</BaseLayout>
