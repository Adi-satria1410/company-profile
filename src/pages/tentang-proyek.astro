---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/common/Container.astro';
const stack = ['Astro (static output)', 'Tailwind CSS 4', 'TypeScript strict', 'Content Collections (Markdown)', 'Formspree untuk form', 'GitHub Actions dan Vercel'];
---
<BaseLayout title="Tentang Proyek Ini" description="Stack, keputusan teknis, dan skor Lighthouse situs demo ini.">
  <Container class="py-16">
    <h1 class="text-4xl font-extrabold tracking-tight">Tentang proyek ini</h1>
    <p class="mt-4 max-w-2xl text-lg">Situs ini adalah demo portofolio. Perusahaan, klien, dan konten semuanya fiktif. Tujuannya menunjukkan cara kami membangun company profile.</p>
    <h2 class="mt-12 text-2xl font-bold">Stack</h2>
    <ul class="mt-3 list-disc pl-6">{stack.map((s) => <li>{s}</li>)}</ul>
    <h2 class="mt-12 text-2xl font-bold">Keputusan utama</h2>
    <ul class="mt-3 list-disc pl-6">
      <li>Situs statis tanpa database agar cepat dan murah dirawat.</li>
      <li>Konten dalam file Markdown dengan validasi schema.</li>
      <li>JavaScript hanya dimuat saat dibutuhkan.</li>
    </ul>
    <h2 class="mt-12 text-2xl font-bold">Skor Lighthouse</h2>
    <p class="mt-3">Isi dengan hasil audit mobile setelah deploy.</p>
  </Container>
</BaseLayout>
