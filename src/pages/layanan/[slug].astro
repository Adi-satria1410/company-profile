---
import { render } from 'astro:content';
import { getSiteContent } from '../../data/content';
import { site } from '../../data/site';
import { imageSrcSet } from '../../data/images';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/common/Button.astro';
export async function getStaticPaths() {
  const { services } = await getSiteContent();
  return services.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.summary}>
  <div class="container">
    <div class="page-heading">
      <a class="eyebrow text-link" href="/layanan">
        ← {site.labels.allServices}
      </a>
      <h1>{entry.data.title}</h1>
      <p>{entry.data.summary}</p>
    </div>
    <article class="article-layout">
      {entry.data.image && (
        <img
          class="article-photo"
          src={entry.data.image}
          srcset={imageSrcSet(entry.data.image)}
          sizes="(max-width: 800px) 100vw, 800px"
          alt={entry.data.alt}
          width="1200"
          height="800"
        />
      )}
      <div class="prose">
        <Content />
        {entry.data.features.length > 0 && (
          <>
            <h2>{site.labels.features}</h2>
            <ul>
              {entry.data.features.map((f) => (
                <li>{f}</li>
              ))}
            </ul>
          </>
        )}
      </div>
      <Button href="/kontak" class="mt-10">
        {site.labels.contactCta}
      </Button>
    </article>
  </div>
</BaseLayout>
