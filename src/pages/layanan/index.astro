---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/common/Container.astro';
import ServiceCard from '../../components/cards/ServiceCard.astro';
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title="Layanan" description="Layanan konsultasi bisnis, manajemen proyek, dan pengembangan SDM dari Nusantara Group.">
  <Container class="py-16">
    <h1 class="text-4xl font-extrabold tracking-tight">Layanan</h1>
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {services.map((s) => <ServiceCard title={s.data.title} summary={s.data.summary} href={`/layanan/${s.id}`} />)}
    </div>
  </Container>
</BaseLayout>
