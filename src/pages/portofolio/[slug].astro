---
import { render } from 'astro:content';
import { getSiteContent } from '../../data/content';
import { site } from '../../data/site';
import { imageSrcSet } from '../../data/images';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/common/Button.astro';
export async function getStaticPaths() {
  const { projects } = await getSiteContent();
  return projects.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const metadata = [
  entry.data.category,
  entry.data.client,
  entry.data.year,
].filter((v) => v !== undefined && v !== '');
---

<BaseLayout title={entry.data.title} description={entry.data.summary}>
  <div class="container">
    <div class="page-heading">
      <a class="eyebrow text-link" href="/portofolio">
        ← {site.labels.allProjects}
      </a>
      <h1>{entry.data.title}</h1>
      <p>{entry.data.summary}</p>
      {metadata.length > 0 && (
        <div class="article-meta">
          {metadata.map((v) => (
            <span>{v}</span>
          ))}
        </div>
      )}
    </div>
    <article class="article-layout">
      {entry.data.image && (
        <img
          class="article-photo"
          src={entry.data.image}
          srcset={imageSrcSet(entry.data.image)}
          sizes="(max-width: 800px) 100vw, 800px"
          alt={entry.data.alt}
          width="1200"
          height="800"
          fetchpriority="high"
        />
      )}
      <div class="prose">
        <Content />
      </div>
      <Button href="/kontak" class="mt-10">
        {site.labels.contactCta}
      </Button>
    </article>
  </div>
</BaseLayout>
